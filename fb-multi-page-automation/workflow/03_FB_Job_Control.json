    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE fb_actions SET text=left($3, 2000), updated_at=now()\nWHERE id=$2::int AND status IN ('pending_approval','scheduled') AND action_type='comment' AND EXISTS (SELECT 1 FROM fb_settings WHERE k='panel_key' AND v=$1) RETURNING id, text, status",
        "options": {
          "queryReplacement": "={{ [ $json.query.key || '', $json.query.action_id || 0, $json.query.text || '' ] }}"
