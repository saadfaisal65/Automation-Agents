    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT j.id, j.status, j.permalink, j.error,\n(SELECT coalesce(json_object_agg(s, c), '{}'::json) FROM (SELECT status s, count(*) c FROM fb_actions WHERE job_id=j.id GROUP BY status) t)::text AS actions\nFROM fb_jobs j WHERE j.id=$2::int AND EXISTS (SELECT 1 FROM fb_settings WHERE k='panel_key' AND v=$1)",
        "options": {
          "queryReplacement": "={{ [ $json.query.key || '', $json.query.job_id || 0 ] }}"
        }
      },
      "id": "082100dc-9de2-4676-8df3-0b7ddd501b74",
      "name": "Status",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        520,
        -300
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_YOUR_POSTGRES_CREDENTIAL",
          "name": "Postgres account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT a.id, ac.name AS account, a.action_type, a.text, a.run_at, a.status, a.last_error\nFROM fb_actions a JOIN fb_accounts ac ON ac.id=a.account_id\nWHERE a.job_id=$2::int AND EXISTS (SELECT 1 FROM fb_settings WHERE k='panel_key' AND v=$1) ORDER BY a.run_at",
        "options": {
          "queryReplacement": "={{ [ $json.query.key || '', $json.query.job_id || 0 ] }}"
        }
      },
      "id": "6337a97c-e8c6-4ff5-93bf-d6e8f45037a0",
      "name": "Preview",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        520,
        -150
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_YOUR_POSTGRES_CREDENTIAL",
          "name": "Postgres account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH ok AS (SELECT 1 WHERE EXISTS (SELECT 1 FROM fb_settings WHERE k='panel_key' AND v=$1)),\nshift AS (SELECT GREATEST(interval '0', now() - min(run_at)) + interval '2 minutes' AS d FROM fb_actions WHERE job_id=$2::int AND status='pending_approval'),\nu AS (UPDATE fb_actions SET status='scheduled', run_at = run_at + (SELECT d FROM shift), updated_at=now()\n      WHERE job_id=$2::int AND status='pending_approval' AND EXISTS (SELECT 1 FROM ok) RETURNING id),\nj AS (UPDATE fb_jobs SET status='scheduled' WHERE id=$2::int AND status='awaiting_approval' AND EXISTS (SELECT 1 FROM ok) RETURNING id)\nSELECT (SELECT count(*) FROM u) AS approved_actions, (SELECT count(*) FROM ok) AS authorized",
        "options": {
          "queryReplacement": "={{ [ $json.query.key || '', $json.query.job_id || 0 ] }}"
        }
      },
      "id": "39ba2ecc-1c99-4e1f-bc3c-52cfe251723e",
      "name": "Approve",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        520,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_YOUR_POSTGRES_CREDENTIAL",
          "name": "Postgres account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH ok AS (SELECT 1 WHERE EXISTS (SELECT 1 FROM fb_settings WHERE k='panel_key' AND v=$1)),\nu AS (UPDATE fb_actions SET status='cancelled', last_error='Cancelled by user', updated_at=now()\n      WHERE job_id=$2::int AND status IN ('pending_approval','scheduled') AND EXISTS (SELECT 1 FROM ok) RETURNING id),\nj AS (UPDATE fb_jobs SET status='cancelled' WHERE id=$2::int AND EXISTS (SELECT 1 FROM ok) RETURNING id)\nSELECT (SELECT count(*) FROM u) AS cancelled_actions, (SELECT count(*) FROM ok) AS authorized",
        "options": {
          "queryReplacement": "={{ [ $json.query.key || '', $json.query.job_id || 0 ] }}"
        }
      },
      "id": "ce758333-43ed-47af-822e-a797396d8bfd",
