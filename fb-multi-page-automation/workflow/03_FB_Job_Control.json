    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH ok AS (SELECT 1 WHERE EXISTS (SELECT 1 FROM fb_settings WHERE k='panel_key' AND v=$1)),\nu AS (UPDATE fb_actions SET status='cancelled', last_error='Kill switch', updated_at=now()\n      WHERE status IN ('pending_approval','scheduled') AND EXISTS (SELECT 1 FROM ok) RETURNING id),\nj AS (UPDATE fb_jobs SET status='cancelled' WHERE status IN ('scheduled','awaiting_approval') AND EXISTS (SELECT 1 FROM ok) RETURNING id)\nSELECT (SELECT count(*) FROM u) AS cancelled_actions, (SELECT count(*) FROM ok) AS authorized",
        "options": {
          "queryReplacement": "={{ [ $json.query.key || '', $json.query.job_id || 0 ] }}"
        }
