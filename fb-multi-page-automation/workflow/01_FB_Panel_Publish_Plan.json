    {
      "parameters": {
        "jsCode": "const j = $('Load Job').first().json;\nconst base = 'https://graph.facebook.com/v21.0/' + j.page_id;\nlet url, body;\nif (j.post_type === 'photo') { url = base + '/photos'; body = { url: j.media_url, caption: j.message || '', published: true }; }\nelse if (j.post_type === 'video') { url = base + '/videos'; body = { file_url: j.media_url, description: j.message || '' }; }\nelse { url = base + '/feed'; body = { message: j.message }; }\nreturn [{ json: { job_id: j.job_id, access_token: j.access_token, url, body } }];"
      },
