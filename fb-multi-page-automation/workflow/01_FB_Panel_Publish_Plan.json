      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Build Publish Request').first().json;\nconst j = $('Load Job').first().json;\nconst r = $input.first().json;\nconst body = r.body || {};\nconst err = r.error || body.error || null;\nconst sc = r.statusCode || 0;\nconst oid = body.post_id || body.id;\nif (!err && sc >= 200 && sc < 300 && oid) {\n  return [{ json: { ok: true, job_id: ctx.job_id, object_id: String(oid), access_token: ctx.access_token } }];\n}\nconst msg = ((err && (err.message || err.description)) || (typeof err === 'string' ? err : JSON.stringify(err || body))).toString().slice(0, 500);\nconst code = err && typeof err === 'object' && err.code ? ' (code ' + err.code + ')' : '';\nreturn [{ json: { ok: false, job_id: ctx.job_id, error: msg + code, alert_url: j.alert_url || '',\n  alert_text: 'FB post FAIL - Job #' + ctx.job_id + ' (' + j.source_name + '): ' + msg + code } }];"
      },
