      "id": "2a664726-3ba0-4104-9f8f-2308f48178ee",
      "name": "Load Targets",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        3360,
        220
      ],
      "credentials": {
        "postgres": {
