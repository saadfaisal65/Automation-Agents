    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO fb_jobs (source_account_id, post_type, message, media_url, delay_min, delay_max, comment_mode, share_enabled, target_ids, languages, status)\nSELECT $2::int, $3, $4, $5, $6::int, $7::int, $8, $9::boolean, $10::jsonb, $11::jsonb, 'publishing'\nWHERE EXISTS (SELECT 1 FROM fb_settings WHERE k='panel_key' AND v=$1)\nAND EXISTS (SELECT 1 FROM fb_accounts WHERE id=$2::int AND active)\nAND NOT EXISTS (SELECT 1 FROM fb_jobs WHERE source_account_id=$2::int AND coalesce(message,'')=$4 AND coalesce(media_url,'')=$5 AND created_at > now() - interval '10 minutes')\nRETURNING id",
        "options": {
