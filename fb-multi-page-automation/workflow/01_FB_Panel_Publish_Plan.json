    {
      "parameters": {
        "jsCode": "const job = $('Load Job').first().json;\nconst post = $('Normalize Post').first().json;\nconst targets = $('Load Targets').all().map(i => i.json).filter(t => t.id);\nconst hdr = ($('Submit Job').first().json.headers) || {};\nconst base = (hdr['x-forwarded-proto'] || 'https') + '://' + (hdr['x-forwarded-host'] || hdr.host || 'YOUR-N8N-HOST');\nconst parse = v => (typeof v === 'string' ? JSON.parse(v) : v) || [];\nconst langs = parse(job.languages).length ? parse(job.languages) : ['mixed'];\nconst dmin = Math.max(1, Number(job.delay_min)), dmax = Math.max(dmin, Number(job.delay_max));\nconst mode = job.comment_mode;\nconst rnd = (a, b) => a + Math.random() * (b - a);\nconst shuffle = a => { a = [...a]; for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; };\n\nconst msg = (job.message || '').toLowerCase();\nconst has = re => re.test(msg);\nlet topic = 'general';\nif (has(/mubarak|congrat|badhai|winner|graduat|anniversary|birthday|eid/)) topic = 'celebrate';\nelse if (has(/food|recipe|biryani|karahi|pizza|burger|restaurant|khana|chai|dessert|cafe/)) topic = 'food';\nelse if (has(/travel|trip|tour|hunza|swat|murree|beach|mountain|vacation|safar|view/)) topic = 'travel';\nelse if (has(/motivat|success|hard work|mehnat|dream|believe|quote|zindagi/)) topic = 'motivation';\nelse if (job.post_type === 'video') topic = 'video';\nelse if (job.post_type === 'photo') topic = 'photo';\n\nconst BANK = {\n  english: {\n    general: ['Love this! ❤️', 'Awesome post 👏', 'Great stuff, keep it up 🔥', 'Really well done!', 'This is brilliant 😍', 'Wow, nicely done 👌', 'Absolutely love it ❤️', 'Super impressive 🙌', 'Looks fantastic!', 'Well said 👏', 'Keep up the great work 💪', 'Brilliant! 🔥'],\n    video: ['Great video 🎥🔥', 'Loved watching this ❤️', 'Superb content 👏', 'This video is amazing 😍', 'Quality content, keep sharing!'],\n    photo: ['Beautiful shot 📸😍', 'Stunning picture ❤️', 'Love this photo 🔥', 'What a great frame!', 'Looks amazing 😍'],\n    food: ['This looks delicious 😋', 'Yummy! 🤤🔥', \"Now I'm hungry 😍\", 'Mouth-watering 😋'],\n    travel: ['What a view 😍', 'Beautiful place ❤️', 'Dream destination ✈️🔥', 'Stunning scenery!'],\n    celebrate: ['Congratulations! 🎉', 'Many congratulations ❤️', 'Well deserved 👏', 'Huge congrats 🥳'],\n    motivation: ['So true 👏', 'Great reminder 💯', 'Needed this today ❤️', 'Powerful words 🔥']\n  },\n  roman_urdu: {\n    general: ['Mashallah ❤️', 'Bohat khoob 👏', 'Zabardast yaar 🔥', 'Wah wah, kamaal kar diya 😍', 'Bohat acha laga ❤️', 'Shabash, aise hi karte raho 💪', 'Kya baat hai! 👌', 'Dil khush kar diya ❤️', 'Bohat umda 👏', 'Lajawab 🔥', 'Allah aap ko kamyab kare ❤️', 'Kamaal hai bhai 😍'],\n    video: ['Zabardast video 🎥🔥', 'Maza aa gaya dekh kar ❤️', 'Bohat acha content hai 👏', 'Kamaal ki video hai 😍'],\n    photo: ['Bohat khoobsurat picture 📸😍', 'Mashallah kya baat hai ❤️', 'Lajawab tasveer 🔥', 'Wah, kamaal ki photo 👌'],\n    food: ['Dekh kar hi munh mein pani aa gaya 😋', 'Bohat mazedar lag raha hai 🤤', 'Zabardast 😍🔥', 'Bhook lag gayi 😋'],\n    travel: ['Mashallah kya nazara hai 😍', 'Bohat khoobsurat jagah ❤️', 'Wah, dil khush ho gaya 🔥', 'Zabardast jagah hai!'],\n    celebrate: ['Bohat bohat mubarak ho 🎉', 'Mubarak ho ❤️', 'Allah barkat de 🤲', 'Dher saari mubarakbaad 🥳'],\n    motivation: ['Bilkul sahi baat 👏', 'Sach kaha ❤️', 'Bohat acha reminder 💯', 'Zabardast soch 🔥']\n  }\n};\nBANK.mixed = {};\nfor (const k of Object.keys(BANK.english)) BANK.mixed[k] = BANK.english[k].concat(BANK.roman_urdu[k]);\nBANK.mixed.general.push('Wow bhai, zabardast! 😍', 'Love this, mashallah ❤️', 'Superb yaar 🔥', 'Bohat nice post 👏', 'Great work, shabash! 💪', 'Kya baat hai, awesome 😍');\nconst REACT = ['❤️❤️❤️', '🔥🔥🔥', '😍😍', '👏👏👏', 'Wow! 😮', 'Wow 😍', '💯🔥'];\n\nconst pool = [];\nfor (const l of langs) { const b = BANK[l]; if (!b) continue; pool.push(...(b[topic] || []), ...b.general); }\npool.push(...REACT);\nconst uniq = shuffle([...new Set(pool)]);\nconst extra = ['❤️', '🔥', '😍', '👏', '💯', '🙌'];\nlet ci = 0;\nconst nextComment = () => {\n  if (ci < uniq.length) return uniq[ci++];\n  return uniq[Math.floor(Math.random() * uniq.length)] + ' ' + extra[Math.floor(Math.random() * extra.length)];\n};\n\nconst actions = [];\nconst plan = (type) => {\n  let t = Date.now() + rnd(dmin, dmax) * 60000;\n  for (const acc of shuffle(targets)) {\n    actions.push({\n      account_id: acc.id, action_type: type,\n      text: type === 'comment' ? nextComment() : '',\n      run_at: new Date(t).toISOString(),\n      status: mode === 'approval' ? 'pending_approval' : 'scheduled'\n    });\n    t += rnd(dmin, dmax) * 60000;\n  }\n};\nif (mode !== 'off') plan('comment');\nif (job.share_enabled) plan('share');\n\nlet jobStatus = 'scheduled';\nif (!actions.length) jobStatus = 'completed';\nelse if (mode === 'approval') jobStatus = 'awaiting_approval';\nconst alertUrl = job.alert_url || '';\nconst alert = mode === 'approval' && actions.length > 0 && !!alertUrl;\nreturn [{ json: { job_id: job.job_id, actions, job_status: jobStatus, alert, alert_url: alertUrl,\n  alert_text: 'Job #' + job.job_id + ' post ho gaya (' + post.permalink + '). ' + actions.length + ' actions approval ka intezar kar rahe hain. Panel: ' + base + '/webhook/fb-panel' } }];"
      },
