    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst errors = [];\nconst num = (v, d) => { const n = parseInt(v, 10); return Number.isFinite(n) ? n : d; };\nconst src = num(b.source_account_id, 0);\nlet targets = Array.isArray(b.target_ids) ? b.target_ids.map(x => num(x, 0)).filter(x => x > 0 && x !== src) : [];\ntargets = [...new Set(targets)];\nif (!b.key) errors.push('Access key missing');\nif (!src) errors.push('Source account select karein');\nif (!targets.length) errors.push('Kam az kam 1 target account select karein');\nif (!['text', 'photo', 'video'].includes(b.post_type)) errors.push('Post type ghalat hai');\nconst message = (b.message || '').toString().trim();\nconst media = (b.media_url || '').toString().trim();\nif (b.post_type === 'text' && !message) errors.push('Text post ke liye message zaroori hai');\nif (['photo', 'video'].includes(b.post_type) && !/^https:\\/\\/\\S+$/i.test(media)) errors.push('Photo/Video ke liye public https media URL dein');\nif (message.length > 5000) errors.push('Message 5000 characters se zyada nahi ho sakta');\nlet dmin = num(b.delay_min, 10), dmax = num(b.delay_max, 60);\nif (dmin < 1) dmin = 1;\nif (dmax < dmin) dmax = dmin;\nif (dmax > 1440) errors.push('Max gap 1440 minute se zyada nahi ho sakta');\nconst mode = ['off', 'approval', 'auto'].includes(b.comment_mode) ? b.comment_mode : 'approval';\nconst langs = (Array.isArray(b.languages) ? b.languages : []).filter(l => ['english', 'roman_urdu', 'mixed'].includes(l));\nreturn [{ json: { ok: errors.length === 0, errors, key: String(b.key || ''), source: src, targets,\n  post_type: b.post_type, message, media, dmin, dmax, mode, share: !!b.share_enabled,\n  langs: langs.length ? langs : ['mixed'] } }];"
      },
