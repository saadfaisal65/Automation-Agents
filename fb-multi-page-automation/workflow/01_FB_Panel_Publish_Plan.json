    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>FB Multi-Page Panel</title>\n<style>\nbody{font-family:system-ui,Arial,sans-serif;background:#f0f2f5;margin:0;padding:16px;color:#1c1e21}\n.card{background:#fff;max-width:720px;margin:0 auto 16px;padding:18px;border-radius:10px;box-shadow:0 1px 3px #0002}\nh2{margin:0 0 12px;font-size:18px}label{display:block;margin:10px 0 4px;font-weight:600;font-size:14px}\ninput,select,textarea{width:100%;box-sizing:border-box;padding:9px;border:1px solid #ccd0d5;border-radius:6px;font-size:14px}\n.row{display:flex;gap:10px}.row>div{flex:1}\n.chk{display:flex;align-items:center;gap:8px;margin:4px 0;font-weight:400}.chk input{width:auto}\nbutton{background:#1877f2;color:#fff;border:0;padding:10px 14px;border-radius:6px;font-weight:600;cursor:pointer;margin:8px 8px 0 0}\nbutton.red{background:#d93025}button.grey{background:#65676b}button.green{background:#188038}\n#msg,#out{white-space:pre-wrap;font-size:13px;margin-top:10px}.err{color:#d93025}.ok{color:#188038}\ntable{width:100%;border-collapse:collapse;font-size:13px}td,th{border-bottom:1px solid #eee;padding:6px;text-align:left;vertical-align:top}\n</style></head><body>\n<div class=\"card\"><h2>Access</h2><label>Panel key</label><input id=\"key\" type=\"password\" autocomplete=\"off\">\n<button onclick=\"loadAccounts()\">Accounts load karein</button><div id=\"msg\"></div></div>\n\n<div class=\"card\" id=\"form\" style=\"display:none\"><h2>Naya Post</h2>\n<label>Kis account se post karni hai?</label><select id=\"src\" onchange=\"renderTargets()\"></select>\n<label>Baqi accounts jo react karenge</label><div id=\"targets\"></div>\n<label>Post type</label><select id=\"ptype\" onchange=\"toggleMedia()\"><option value=\"text\">Text</option><option value=\"photo\">Photo</option><option value=\"video\">Video</option></select>\n<div id=\"mediaBox\" style=\"display:none\"><label>Media URL (public https link)</label><input id=\"media\" placeholder=\"https://...\"></div>\n<label>Message / Caption</label><textarea id=\"message\" rows=\"4\"></textarea>\n<div class=\"row\"><div><label>Min gap (minutes)</label><input id=\"dmin\" type=\"number\" value=\"10\" min=\"1\"></div>\n<div><label>Max gap (minutes)</label><input id=\"dmax\" type=\"number\" value=\"60\" min=\"1\"></div></div>\n<label>Comments</label><select id=\"cmode\"><option value=\"approval\" selected>Approval ke baad (recommended)</option><option value=\"auto\">Auto</option><option value=\"off\">Off</option></select>\n<label>Comment language</label>\n<label class=\"chk\"><input type=\"checkbox\" class=\"lang\" value=\"english\"> English</label>\n<label class=\"chk\"><input type=\"checkbox\" class=\"lang\" value=\"roman_urdu\"> Roman Urdu</label>\n<label class=\"chk\"><input type=\"checkbox\" class=\"lang\" value=\"mixed\" checked> Mix (English + Roman Urdu)</label>\n<label class=\"chk\"><input type=\"checkbox\" id=\"share\"> Baqi accounts post ka link share bhi karein</label>\n<button onclick=\"submitJob()\">Publish + Schedule</button></div>\n\n<div class=\"card\"><h2>Job Control</h2><input id=\"jobid\" type=\"number\" placeholder=\"Job ID\">\n<button class=\"grey\" onclick=\"ctl('status')\">Status</button>\n<button class=\"grey\" onclick=\"ctl('preview')\">Comments dekhein</button>\n<button class=\"green\" onclick=\"ctl('approve')\">Approve</button>\n<button class=\"red\" onclick=\"ctl('cancel')\">Job cancel</button>\n<button class=\"red\" onclick=\"killAll()\">KILL SWITCH (sab rokein)</button>\n<div id=\"out\"></div></div>\n<script>\nconst $=id=>document.getElementById(id);\nlet accounts=[];\nconst key=()=>$('key').value.trim();\ntry{$('key').value=localStorage.getItem('fbkey')||'';}catch(e){}\nfunction esc(s){return String(s).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));}\nfunction say(t,c){$('msg').className=c||'';$('msg').textContent=t;}\nasync function api(path,opt){\n  const r=await fetch(path,opt);let d=null;\n  try{d=await r.json();}catch(e){}\n  if(!r.ok)throw new Error((d&&d.errors&&d.errors.join(', '))||(d&&d.message)||('HTTP '+r.status));\n  return d;\n}\nasync function loadAccounts(){\n  try{\n    try{localStorage.setItem('fbkey',key());}catch(e){}\n    const d=await api('fb-accounts?key='+encodeURIComponent(key()));\n    accounts=(Array.isArray(d)?d:[]).filter(a=>a&&a.id);\n    if(!accounts.length){say('Koi account nahi mila (key ghalat hai ya accounts add nahi).','err');return;}\n    $('src').innerHTML=accounts.map(a=>'<option value=\"'+a.id+'\">'+esc(a.name)+'</option>').join('');\n    renderTargets();$('form').style.display='block';say('Accounts load: '+accounts.length,'ok');\n  }catch(e){say(e.message,'err');}\n}\nfunction renderTargets(){\n  const s=$('src').value;\n  $('targets').innerHTML=accounts.filter(a=>String(a.id)!==s).map(a=>\n    '<label class=\"chk\"><input type=\"checkbox\" class=\"tgt\" value=\"'+a.id+'\" checked> '+esc(a.name)+'</label>').join('')||'<i>Sirf 1 account hai</i>';\n}\nfunction toggleMedia(){$('mediaBox').style.display=$('ptype').value==='text'?'none':'block';}\nasync function submitJob(){\n  const body={key:key(),source_account_id:+$('src').value,\n    target_ids:[...document.querySelectorAll('.tgt:checked')].map(c=>+c.value),\n    post_type:$('ptype').value,message:$('message').value,media_url:$('media')?$('media').value:'',\n    delay_min:+$('dmin').value,delay_max:+$('dmax').value,comment_mode:$('cmode').value,\n    share_enabled:$('share').checked,languages:[...document.querySelectorAll('.lang:checked')].map(c=>c.value)};\n  const name=(accounts.find(a=>a.id==body.source_account_id)||{}).name;\n  if(!confirm('Post \"'+name+'\" se publish hogi. Confirm?'))return;\n  try{\n    const d=await api('fb-submit',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});\n    $('jobid').value=d.job_id;\n    say('Job #'+d.job_id+' queue ho gaya. Status/Preview Job Control se dekhein.','ok');\n  }catch(e){say(e.message,'err');}\n}\nfunction table(rows){\n  if(!Array.isArray(rows)||!rows.length||!rows[0]||!Object.keys(rows[0]).length)return '<i>Kuch nahi mila</i>';\n  const h=Object.keys(rows[0]);\n  return '<table><tr>'+h.map(k=>'<th>'+esc(k)+'</th>').join('')+'</tr>'+rows.map(r=>'<tr>'+h.map(k=>'<td>'+esc(r[k]??'')+'</td>').join('')+'</tr>').join('')+'</table>';\n}\nasync function ctl(op){\n  const id=$('jobid').value;\n  if(!id){$('out').textContent='Job ID likhein';return;}\n  if(op==='cancel'&&!confirm('Job cancel karni hai?'))return;\n  try{\n    const d=await api('fb-control?op='+op+'&job_id='+encodeURIComponent(id)+'&key='+encodeURIComponent(key()));\n    $('out').innerHTML=table(d);\n  }catch(e){$('out').textContent=e.message;}\n}\nasync function killAll(){\n  if(!confirm('SAB pending/scheduled actions cancel ho jayenge. Pakka?'))return;\n  try{const d=await api('fb-control?op=killswitch&job_id=0&key='+encodeURIComponent(key()));$('out').innerHTML=table(d);}\n  catch(e){$('out').textContent=e.message;}\n}\n</script></body></html>",
