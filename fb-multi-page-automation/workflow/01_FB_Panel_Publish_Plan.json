        "query": "SELECT j.id AS job_id, j.post_type, j.message, j.media_url, j.delay_min, j.delay_max, j.comment_mode, j.share_enabled, j.target_ids, j.languages,\na.name AS source_name, a.page_id, a.access_token,\n(SELECT v FROM fb_settings WHERE k='alert_url') AS alert_url\nFROM fb_jobs j JOIN fb_accounts a ON a.id=j.source_account_id WHERE j.id=$1::int",
