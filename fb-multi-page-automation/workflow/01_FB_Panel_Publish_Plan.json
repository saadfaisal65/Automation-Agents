        "jsCode": "const pub = $('Evaluate Publish').first().json;\nconst pl = $input.first().json;\nlet link = (pl.body && pl.body.permalink_url) || '';\nif (link.startsWith('/')) link = 'https://www.facebook.com' + link;\nif (!link) link = 'https://www.facebook.com/' + pub.object_id;\nreturn [{ json: { job_id: pub.job_id, object_id: pub.object_id, permalink: link } }];"
