    {
      "parameters": {
        "jsCode": "const c = $json;\nconst now = Date.now();\nlet route = 'go', minutes = 0, reason = '';\nif (c.job_status === 'cancelled') { route = 'skip'; reason = 'Job cancelled'; }\nelse if (!c.active) { route = 'skip'; reason = 'Account inactive / token invalid'; }\nelse if (c.action_type === 'comment' && (!c.text || !c.fb_post_id)) { route = 'skip'; reason = 'Comment text ya post id missing'; }\nelse if (c.paused_until && new Date(c.paused_until).getTime() > now) { route = 'defer'; minutes = Math.ceil((new Date(c.paused_until).getTime() - now) / 60000) + 1; reason = 'Account paused (rate limit/block)'; }\nelse if (Number(c.done_24h) >= Number(c.daily_cap)) { route = 'defer'; minutes = 60; reason = 'Daily cap reached'; }\nreturn { json: { ...c, route, minutes, reason } };",
        "mode": "runOnceForEachItem"
      },
