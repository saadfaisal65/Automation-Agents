    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT a.id AS action_id, a.action_type, a.text, a.attempts,\nac.id AS account_id, ac.name, ac.page_id, ac.access_token, ac.daily_cap, ac.active, ac.paused_until,\nj.id AS job_id, j.status AS job_status, j.fb_post_id, j.permalink,\n(SELECT count(*) FROM fb_actions x WHERE x.account_id=a.account_id AND x.status='done' AND x.updated_at > now() - interval '24 hours') AS done_24h,\ncoalesce((SELECT v FROM fb_settings WHERE k='alert_url'),'') AS alert_url\nFROM fb_actions a JOIN fb_accounts ac ON ac.id=a.account_id JOIN fb_jobs j ON j.id=a.job_id WHERE a.id=$1::int",
        "options": {
