    {
      "parameters": {
        "jsCode": "const c = $json;\nlet url, body;\nif (c.action_type === 'comment') { url = 'https://graph.facebook.com/v21.0/' + c.fb_post_id + '/comments'; body = { message: c.text }; }\nelse { url = 'https://graph.facebook.com/v21.0/' + c.page_id + '/feed'; body = { link: c.permalink }; }\nreturn { json: { ...c, url, body } };",
