    {
      "parameters": {
        "jsCode": "const c = $('Build Request').item.json;\nconst r = $json;\nconst body = r.body || {};\nconst err = r.error || body.error || null;\nconst sc = r.statusCode || 0;\nif (!err && sc >= 200 && sc < 300 && (body.id || body.success)) {\n  return { json: { outcome: 'done', action_id: c.action_id, account_id: c.account_id, result_id: String(body.id || 'ok'), alert: false } };\n}\nconst code = (err && typeof err === 'object') ? Number(err.code || 0) : 0;\nconst msg = ((err && (err.message || err.description)) || (typeof err === 'string' ? err : JSON.stringify(err || body))).toString().slice(0, 400);\nlet status = 'scheduled', delay = 5 * Math.max(1, Number(c.attempts)), disable = false, pause = 0, alert = false;\nif ([190, 102].includes(code)) { status = 'failed'; disable = true; alert = true; delay = 0; }\nelse if (code === 368) { delay = 1440; pause = 1440; alert = true; }\nelse if ([4, 17, 32, 613].includes(code) || (code >= 80000 && code <= 80010)) { delay = 60; pause = 60; }\nelse if ([10, 200, 299, 100, 803, 506].includes(code)) { status = 'failed'; alert = true; delay = 0; }\nelse if (sc >= 500 || !sc || [1, 2].includes(code)) { /* transient: retry with backoff */ }\nelse { status = 'failed'; alert = true; delay = 0; }\nif (status === 'scheduled' && Number(c.attempts) >= 4) { status = 'failed'; alert = true; delay = 0; }\nconst text = 'FB action FAIL - job #' + c.job_id + ', ' + c.action_type + ' by ' + c.name + ': ' + msg + ' (code ' + code + ', http ' + sc + ') -> ' + status + (disable ? ', ACCOUNT DISABLED' : '');\nreturn { json: { outcome: 'error', action_id: c.action_id, account_id: c.account_id, new_status: status,\n  delay: status === 'scheduled' ? Math.max(1, delay) : 0, disable, pause, error: msg, alert: alert && !!c.alert_url,\n  alert_url: c.alert_url || '', alert_text: text } };",
        "mode": "runOnceForEachItem"
      },
