        "query": "UPDATE fb_jobs j SET status = CASE WHEN EXISTS (SELECT 1 FROM fb_actions a WHERE a.job_id=j.id AND a.status='failed') THEN 'completed_with_errors' ELSE 'completed' END\nWHERE j.status='scheduled' AND EXISTS (SELECT 1 FROM fb_actions a WHERE a.job_id=j.id)\nAND NOT EXISTS (SELECT 1 FROM fb_actions a WHERE a.job_id=j.id AND a.status IN ('scheduled','processing','pending_approval'))",
