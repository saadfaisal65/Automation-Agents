      "parameters": {
        "operation": "executeQuery",
        "query": "WITH due AS (\n  SELECT id FROM fb_actions WHERE status='scheduled' AND run_at <= now() ORDER BY run_at LIMIT 5 FOR UPDATE SKIP LOCKED)\nUPDATE fb_actions a SET status='processing', attempts=a.attempts+1, updated_at=now()\nFROM due WHERE a.id=due.id RETURNING a.id",
