        "jsonBody": "={{ JSON.stringify({ text: 'n8n ERROR in \"' + $('Error Trigger').first().json.workflow.name + '\" at node ' + ($('Error Trigger').first().json.execution.lastNodeExecuted || '?') + ': ' + ($('Error Trigger').first().json.execution.error.message || 'unknown'), content: 'n8n ERROR in ' + $('Error Trigger').first().json.workflow.name }) }}"
