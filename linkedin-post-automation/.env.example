# Timezone used by the Schedule Trigger (change to yours)
TZ=Asia/Karachi
GENERIC_TIMEZONE=Asia/Karachi

# REQUIRED: generate your own with `openssl rand -hex 32`, keep it private and back it up.
# If you lose it, saved n8n credentials can no longer be decrypted.
N8N_ENCRYPTION_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# OPTIONAL: only if n8n is reachable on a public HTTPS URL (for example a Cloudflare Tunnel).
# Useful when LinkedIn refuses an http://localhost OAuth redirect URL. No trailing slash on the first one.
# N8N_EDITOR_BASE_URL=https://n8n.yourdomain.com
# WEBHOOK_URL=https://n8n.yourdomain.com/

# API keys (Groq, Tavily, OpenAI, LinkedIn) are NOT stored here.
# Add them as Credentials inside n8n. See README, step 2.
