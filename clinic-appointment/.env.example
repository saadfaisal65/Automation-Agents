# n8n / clinic configuration
TZ=Asia/Karachi
GENERIC_TIMEZONE=Asia/Karachi
CLINIC_GOOGLE_SHEET_ID=YOUR_GOOGLE_SHEET_ID

# Public HTTPS address that Vapi can reach, no trailing slash
N8N_PUBLIC_URL=https://YOUR_PUBLIC_N8N_DOMAIN

# Optional outbound reminder-call branch
VAPI_PRIVATE_KEY=
VAPI_REMINDER_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# Recommended for self-hosted n8n. Generate your own long random value and keep it private.
N8N_ENCRYPTION_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
